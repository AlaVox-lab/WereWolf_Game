{
  "name": "lang-trang-mo",
  "private": true,
  "description": "Làng Trăng Mờ (MoonVillage) — trò chơi suy luận nhóm, máy làm quản trò",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @moonvillage/server",
    "dev:web": "npm run dev --workspace @moonvillage/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker-compose.yml --env-file infra/.env.example up -d",
    "db:down": "docker compose -f infra/docker-compose.yml --env-file infra/.env.example down",
    "so-do": "node scripts/xuat-so-do.mjs",
    "mo-phong": "tsx scripts/mo-phong.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
