' Sequence Diagram pha đêm
' Vẽ lại theo mã BoDieuPhoiVan.xuLyPhaDem() và sauDem() ngày 03/11/2026 — khác Hình 10.1 tài liệu gốc, xem README.
@startuml
skinparam sequenceMessageAlign left
actor "Người chơi\n(có vai)" as NC
participant ":CongLuaChon" as CL
participant ":BoDieuPhoiVan" as DP
participant ":VanDau" as VD
participant ":LuotChoi" as LC
participant ":VaiTro" as VT
participant ":BoGiaiQuyetDem" as GQ
participant ":BoKiemTraThangThua" as KT
participant ":BoPhatSuKien" as SK

DP -> VD : taoLuotMoi()
VD --> DP : luot
DP -> DP : layThuTuBuocDem()
note right of DP : Thứ tự sinh từ doUuTien của vai trong\ncấu hình (Bảo vệ 10, Sói 20, Tiên tri 30,\nPhù thủy 40) — không viết cứng (PC09)
loop với mỗi bước đêm
  alt không còn ai sống giữ vai này
    DP -> DP : choBuocGia()
    note right : chờ ngẫu nhiên 8–15 giây (Q05)
  else còn người giữ vai
    DP -> VT : layCacLuaChon(nc)
    VT --> DP : danh sách mục tiêu hợp lệ
    DP -> CL : cho(nguoiChoiId, thoiHan, kiemTra)
    DP -> SK : phat(MOI_HANH_DONG)\nchỉ gửi người được mời
    NC -> CL : ghiNhan(nguoiChoiId, luaChon)
    CL -> VT : thucHienLuot(nc, luaChon)
    note right : Template Method: kiểm mục tiêu,\nràng buộc BR04–BR06 rồi dungNangLuc()
    VT --> CL : HanhDongDem
    CL --> DP : HanhDongDem (hoặc null khi hết giờ — BR12)
    DP -> LC : ghiYDinh(hanhDong)
    note right : chỉ GHI ý định,\nchưa đổi trạng thái người chơi
  end
end
DP -> VD : chuyenPha(ketThucDem)
DP -> GQ : giaiQuyet(van)
activate GQ
GQ -> LC : layYDinh()
GQ -> GQ : sắp theo doUuTien, chạy chuỗi\nbuocBaoVe → buocCan → buocCuu → buocDoc
GQ -> VD : danhDauChet(danhSach)
GQ --> DP : ketQuaDem
deactivate GQ
DP -> GQ : xuLyDayChuyen(van, nguoiChet, moiThoSanBan)
GQ --> DP : danh sách phát bắn (BR09, BR10)
DP -> KT : kiemTra(van)
alt CHUA_KET_THUC
  KT --> DP : CHUA_KET_THUC
  DP -> VD : chuyenPha(chuaKetThuc)
  DP -> SK : phat(CONG_BO_SANG)\nkhông kèm nguyên nhân chết
else có phe thắng
  KT --> DP : PHE_SOI_THANG / PHE_DAN_THANG
  DP -> VD : ketThuc(pheThang)
  DP -> SK : phat(KET_THUC)
end
@enduml
