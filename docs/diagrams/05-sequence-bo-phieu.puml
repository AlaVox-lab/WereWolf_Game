' Sequence Diagram pha bỏ phiếu
' Vẽ lại theo mã BoDieuPhoiVan.xuLyPhaNgay() ngày 03/11/2026 — khác Hình 10.2 tài liệu gốc, xem README.
@startuml
skinparam sequenceMessageAlign left
actor "Người chơi\ncòn sống" as NC
participant ":CongLuaChon" as CL
participant ":BoDieuPhoiVan" as DP
participant ":PhienBauCu" as PB
participant ":VanDau" as VD
participant ":BoGiaiQuyetDem" as GQ
participant ":BoKiemTraThangThua" as KT

DP -> VD : chuyenPha(hetGioThaoLuan)
create PB
DP -> PB : new PhienBauCu(soLuot, cuTri, thoiHan)
loop với mỗi cử tri còn sống (song song)
  DP -> CL : cho(nguoiChoiId, thoiHan, kiemTra)
  NC -> CL : ghiNhan(nguoiChoiId, mucTieu | bỏ trắng)
  CL -> PB : ghiPhieu(nguoiBauId, nguoiBiBauId, thoiDiem)
  note right : hết giờ chưa bầu = bỏ trắng
end
DP -> PB : kiemPhieu(boLuatChoi)
alt BAU_LAI (hòa và BR11 tắt — Q03)
  DP -> PB : taoVongBauLai(thoiHan)
  PB --> DP : vongLai
  DP -> DP : thu phiếu vòng lại như trên
  DP -> PB : kiemPhieu(boLuatChoi)
end
DP -> VD : chuyenPha(ketThucBoPhieu)
alt TREO_CO
  DP -> VD : danhDauChet(nguoiBiTreo)
  DP -> GQ : xuLyDayChuyen(van, [nguoiBiTreo], moiThoSanBan)
  note right : Thợ săn bị treo được bắn nếu BR09 bật
else KHONG_AI_CHET (hòa — BR11)
  note over DP : không ai bị treo cổ
end
DP -> KT : kiemTra(van)
alt CHUA_KET_THUC
  DP -> VD : chuyenPha(chuaKetThuc)
  note right : sang pha đêm lượt kế tiếp
else có phe thắng
  DP -> VD : ketThuc(pheThang)
end
@enduml
