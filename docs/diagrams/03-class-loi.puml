' Class Diagram phần lõi
' Nguồn: Tài liệu dự án toàn diện, Hình 9.1. Sửa sơ đồ thì cập nhật cả tài liệu gốc.
@startuml
skinparam classAttributeIconSize 0
abstract class VaiTro {
  + loaiVai : LoaiVai
  + tenVai : String
  + phe : Phe
  + doUuTien : int
  + moTaNangLuc : String
  + laHanhDongDem() : boolean
  + coKyNangKhiChet() : boolean
  + laHanhDongTapThe() : boolean
  + layCacLuaChon(nc) : List<NhomLuaChon>
  + layTrangThaiKyNang() : Map
  + thucHienLuot(nc, luaChon) : HanhDongDem
  + kichHoatKhiChet(nc, luaChon) : HanhDongDem
  + layDanhSachMucTieu(nc, loai) : List<NguoiChoi>
  + kiemTraRangBuoc(nc, luaChon) : boolean
  # {abstract} dungNangLuc(nc, luaChon) : HanhDongDem
  # taoPhatBan(nc, luaChon) : HanhDongDem
}
note right of VaiTro
  Template Method: thucHienLuot() và kichHoatKhiChet()
  là khung chung; lớp con chỉ ghi đè ba điểm mở rộng.
  nc = NguCanhHanhDong { van, luat, nguoiThucHien, nanNhanBiCanId }
end note
class DanLang
class BaoVe {
  - mucTieuDemTruoc : String
  + capNhatMucTieuDemTruoc(mt) : void
  + layTrangThaiKyNang() : Map
}
class Soi {
  + laHanhDongTapThe() : boolean
}
class TienTri
class PhuThuy {
  - conThuocCuu : boolean
  - conThuocDoc : boolean
  + truThuocCuu() : void
  + truThuocDoc() : void
  + layCacLuaChon(nc) : List<NhomLuaChon>
  + layTrangThaiKyNang() : Map
}
class ThoSan {
  + coKyNangKhiChet() : boolean
  # taoPhatBan(nc, luaChon) : HanhDongDem
}
VaiTro <|-- DanLang
VaiTro <|-- BaoVe
VaiTro <|-- Soi
VaiTro <|-- TienTri
VaiTro <|-- PhuThuy
VaiTro <|-- ThoSan
abstract class KenhChat {
  + loaiKenh : LoaiKenh
  + {abstract} coTheXem(nc) : boolean
  + {abstract} dangMo(tinhHinh) : boolean
  + coTheGui(nc, tinhHinh) : boolean
  # {abstract} coQuyenGui(nc) : boolean
}
note right of KenhChat
  coTheGui = dangMo && coQuyenGui (Template Method).
  tinhHinh = { trangThai, dangLuotSoi }
end note
class KenhChung
class KenhSoi
class KenhNguoiChet
KenhChat <|-- KenhChung
KenhChat <|-- KenhSoi
KenhChat <|-- KenhNguoiChet
class TaiKhoan {
  - tenDangNhap : String
  - matKhauBam : String
  + xacThuc(mk) : boolean
}
class BoLuatChoi {
  - batDemDauCoChet : boolean
  - camPhuThuyTuCuu : boolean
  - choBaoVeTuDo : boolean
  - camDoTrungDem : boolean
  - thoSanBanKhiTreoCo : boolean
  - hoaPhieuKhongAiChet : boolean
  - daKhoa : boolean
  + chophep(maQuyTac) : boolean
  + datQuyTac(maQuyTac, dangBat) : void
  + kiemTraHopLe() : List<ViPhamBoLuat>
  + layMoTa() : List<MoTaQuyTac>
  + saoChep() : BoLuatChoi
}
class CauHinhVai {
  + {static} macDinh(soNguoi) : CauHinhVai
  - danhSachVaiVaSoLuong : Map<LoaiVai, int>
  + soLuong(loai) : int
  + tongSoVai() : int
  + kiemTraHopLe(soNguoi) : List<ViPhamCauHinh>
}
note top of TaiKhoan : Quản lý người dùng — application/taikhoan,\nkhông thuộc luật chơi (ARCHITECTURE 5.4)
class DichVuTaiKhoan {
  + dangKy(tenDangNhap, bietDanh, matKhau) : ThongTinPhien
  + dangNhap(tenDangNhap, matKhau) : ThongTinPhien
  + capNhatHoSo(taiKhoanId, duLieu) : HoSoLuu
}
DichVuTaiKhoan ..> TaiKhoan : xác thực
class PhongChoi {
  - maPhong : String
  - trangThai : TrangThaiPhong
  + batDauVan() : VanDau
}
note top of PhongChoi : domain/phong — thành viên theo thứ tự vào phòng,\nQ11 chuyển chủ phòng, bộ luật sửa được khi chưa chơi
class SoDangKyPhong {
  + taoPhong(phien) : String
  + vaoPhong(maPhong, phien) : void
  + roiPhong(maPhong, taiKhoanId) : void
  + loai(maPhong, chuPhongId, taiKhoanId) : void
  + chieu(maPhong) : PhongCongKhai
}
SoDangKyPhong "1" o-- "0..*" PhongChoi : phòng đang mở
class SoDangKyVan {
  + batDau(phong, chuPhongId, laNguoiChoiAo) : VanDangChay
  + guiLuaChon(nguoiChoiId, luaChonTho) : void
  + guiTin(nguoiChoiId, kenh, noiDung) : void
  + gocNhin(vanId, nguoiChoiId) : GocNhinNguoiChoi
  + huyVan(vanId) : void
}
SoDangKyPhong ..> SoDangKyVan : UC11 bắt đầu ván
SoDangKyVan "1" o-- "0..*" BoDieuPhoiVan : ván đang chạy
class DichVuLuuVan {
  + dungBanGhi(van, ketThucLuc) : VanDaKetThuc
  + luu(van, ketThucLuc) : String
}
note right of DichVuLuuVan : UC20 — ván xong thì ghi chín bảng nhóm ván,\ncộng hồ sơ và điểm mùa (thắng +3, thua +1) cho người thật
SoDangKyVan ..> DichVuLuuVan : báo kết thúc
class VanDau {
  + id : String
  + boLuatChoi : BoLuatChoi
  - trangThai : TrangThaiVan
  - luotHienTai : int
  - pheThang : Phe
  + layNguoiConSong() : List<NguoiChoi>
  + layNguoiChoi(id) : NguoiChoi
  + layPheCua(id) : Phe
  + taoLuotMoi() : LuotChoi
  + danhDauChet(danhSach) : void
  + chuyenPha(suKien) : TrangThaiVan
  + ketThuc(pheThang) : void
  + huyVan() : void
  + choPhepDoiBoLuat() : boolean
}
note right of VanDau
  Constructor tự giữ boLuatPhong.saoChep()
  đã khóa — bộ luật bất biến trong ván.
  Mẫu State: trạng thái là một TrangThaiVanDau.
end note
class NguoiChoi {
  + id : String
  + taiKhoanId : String
  + thuTuGhe : int
  - conSong : boolean
  - nguyenNhanChet : NguyenNhanChet
  + nhanVai(vai) : void
  + danhDauChet(nguyenNhan, luot) : void
  + coTheHanhDong() : boolean
}
class LuotChoi {
  + soThuTu : int
  + ghiYDinh(hd) : void
  + ganKetQuaDem(kq) : void
  + ganPhienBauCu(phien) : void
}
class NhatKyVan {
  + ghiSuKien(loai, duLieu, thoiDiem) : SuKien
  + dong() : void
  + xuatBanCongKhai() : List<SuKien>
}
class HanhDongDem {
  + nguoiThucHienId : String
  + loaiHanhDong : LoaiHanhDong
  + mucTieuId : String
  + doUuTien : int
}
class KetQuaDem {
  + soDem : int
  + themNguoiChet(id, nguyenNhan) : void
  + themNguoiDuocCuu(id) : void
  + coNguoiChet() : boolean
}
class PhienBauCu {
  + soLuot : int
  + thoiHan : long
  + laVongBauLai : boolean
  - danhSachPhieu : List<PhieuBau>
  - ketQua : KetQuaPhien
  + ghiPhieu(nguoiBau, nguoiBiBau, thoiDiem) : PhieuBau
  + daDuPhieu() : boolean
  + kiemPhieu(luat) : KetQuaPhien
  + xuLyHoa(nguoiHoa, luat) : KetQuaPhien
  + taoVongBauLai(thoiHan) : PhienBauCu
}
class PhieuBau {
  + nguoiBauId : String
  + nguoiBiBauId : String
  + thoiDiem : long
}
note right of PhienBauCu
  KetQuaPhien: TREO_CO | KHONG_AI | BAU_LAI.
  BR11 tắt: hòa thì bầu lại một lần giữa người hòa,
  vòng lại vẫn hòa thì không ai chết (Q03).
end note
class BoDieuPhoiVan {
  + van : VanDau
  - cauHinhVai : CauHinhVai
  + layThuTuBuocDem() : List<LoaiVai>
  + chayVan() : Promise<Phe>
  + xuLyPhaDem() : Promise<KetQuaDem>
  + sauDem() : boolean
  + xuLyPhaNgay() : Promise<KetQuaNgay>
  - kiemTraVaChuyen() : boolean
  + layBuocDemHienTai() : LoaiVai
  + layKetQuaSoi(tienTriId) : List<KetQuaSoi>
  + layThongTinNanNhan() : NanNhan
  + layCongBoSang() : List<String>
  + layKetQuaNgay() : KetQuaNgay
  + dangLuotTapThe() : boolean
  + layLoiMoi(nguoiChoiId) : LoiMoiDangMo
  + layHetHanPha() : long
  + suKien : BoPhatSuKien
}
note top of BoDieuPhoiVan
  Pha đêm (2.2): bước sinh từ doUuTien của vai trong cấu hình;
  vai không còn ai sống vẫn chờ giả 8–15 giây (Q05);
  vai laHanhDongTapThe() đồng thuận, hết giờ chọn ngẫu nhiên (BR12).
  kiemTraVaChuyen() gọi hai lần mỗi lượt: sauDem() và cuối xuLyPhaNgay().
  Hàm taoGocNhin(dieuPhoi, id) chiếu ván thành GocNhinNguoiChoi (PC04).
end note
class BoGiaiQuyetDem {
  - chuoiBuoc : List<BuocGiaiQuyet>
  + {static} xemNanNhan(yDinh) : NanNhan
  + giaiQuyet(van) : KetQuaDem
  + xuLyDayChuyen(van, nguoiVuaChet, chonMucTieu, ketQuaDem) : List<PhatBan>
}
interface BuocGiaiQuyet {
  + loai : LoaiHanhDong
  + xuLy(nc, hanhDong) : void
}
BoGiaiQuyetDem o-- "4" BuocGiaiQuyet
note bottom of BuocGiaiQuyet
  Chain of Responsibility: bước Bảo vệ, Cắn, Cứu, Độc.
  Ý định sắp theo doUuTien rồi đưa vào bước cùng loại.
end note
class BoKiemTraThangThua {
  + kiemTra(van) : KetQuaThangThua
}
note right of BoKiemTraThangThua
  S = 0 → PHE_DAN_THANG (BR02)
  S ≥ D → PHE_SOI_THANG (BR01)
  còn lại → CHUA_KET_THUC
  Gọi hai lần mỗi lượt.
end note
TaiKhoan "1" -- "0..*" NguoiChoi
PhongChoi "1" -- "0..*" VanDau
PhongChoi "1" *-- "1" BoLuatChoi
PhongChoi "1" *-- "1" CauHinhVai
VanDau "1" *-- "1" BoLuatChoi
VaiTro ..> BoLuatChoi
interface VanChiDoc {
  + layNguoiConSong() : List<NguoiChoiTrongVan>
}
interface NguoiChoiTrongVan {
  + id : String
  + vaiTro : VaiTro
}
VaiTro ..> VanChiDoc : đọc qua NguCanhHanhDong
VaiTro ..> NguoiChoiTrongVan
VanChiDoc <|.. VanDau
NguoiChoiTrongVan <|.. NguoiChoi
note bottom of VanChiDoc
  Vai chỉ phụ thuộc hai giao diện này —
  phá vòng NguoiChoi → VaiTro → NguoiChoi.
end note
VanDau "1" *-- "6..12" NguoiChoi
NguoiChoi "1" -- "1" VaiTro
NguoiChoi "1" -- "0..*" HanhDongDem
VanDau "1" *-- "0..*" LuotChoi
LuotChoi "1" o-- "0..*" HanhDongDem
LuotChoi "1" o-- "0..1" KetQuaDem
LuotChoi "1" o-- "0..2" PhienBauCu
VanDau "1" *-- "1" NhatKyVan
abstract class TrangThaiVanDau {
  + ma : TrangThaiVan
  + batDauVan() : TrangThaiVanDau
  + chiaVaiXong() : TrangThaiVanDau
  + ketThucDem() : TrangThaiVanDau
  + chuaKetThuc() : TrangThaiVanDau
  + thoaDieuKien() : TrangThaiVanDau
  + congBoXong() : TrangThaiVanDau
  + hetGioThaoLuan() : TrangThaiVanDau
  + ketThucBoPhieu() : TrangThaiVanDau
  + quaNguongMatKetNoi() : TrangThaiVanDau
  + choPhepDoiBoLuat() : boolean
}
note right of TrangThaiVanDau
  Mười lớp con: ChoDuNguoi, DangChiaVai, PhaDem, GiaiQuyetDem,
  PhaCongBo, PhaThaoLuan, PhaBoPhieu, GiaiQuyetPhieu, KetThuc, HuyVan.
  Mỗi lớp chỉ ghi đè sự kiện có mũi tên đi ra trên sơ đồ 11.1;
  sự kiện khác ném CHUYEN_TRANG_THAI_KHONG_HOP_LE.
end note
VanDau "1" o-- "1" TrangThaiVanDau
PhienBauCu "1" *-- "0..*" PhieuBau
class BoQuanLyKenh {
  - lichSu : List<TinNhan>
  + layTinhHinh() : TinhHinhKenh
  + kenhDangMo() : List<LoaiKenh>
  + layNguoiXem(loai) : List<String>
  + cacKenhXemDuoc(nguoiChoiId) : List<LoaiKenh>
  + coTheGui(nguoiChoiId, loai) : boolean
  + guiTinNhan(nguoiGuiId, loai, noiDung, thoiDiem) : TinNhan
  + layTinNhan(loai, nguoiXemId) : List<TinNhan>
}
class TinNhan {
  + thuTu : int
  + kenh : LoaiKenh
  + nguoiGuiId : String
  + noiDung : String
  + thoiDiem : long
}
BoQuanLyKenh "1" *-- "3" KenhChat
BoQuanLyKenh "1" *-- "0..*" TinNhan
BoQuanLyKenh --> VanDau
BoDieuPhoiVan *-- BoQuanLyKenh
class BoPhatSuKien {
  - cacNguoiNghe : Set<NguoiNghe>
  + dangKy(nguoiNghe) : HuyDangKy
  + dangKyNguoiChoi(nguoiChoiId, nguoiNghe) : HuyDangKy
  + phat(suKien, doiTuong) : void
}
note right of BoPhatSuKien
  Observer. DoiTuongNhan: TAT_CA | NGUOI_CHOI | KENH —
  dịch thành mã người chơi lúc phát; KENH theo quyền xem (BR14).
  SuKienMien: CHUYEN_PHA, DOI_BUOC_DEM, MOI_HANH_DONG, KET_QUA_SOI,
  CONG_BO_SANG, KET_QUA_NGAY, TIN_NHAN, KET_THUC.
end note
BoDieuPhoiVan *-- BoPhatSuKien
BoQuanLyKenh ..> BoPhatSuKien : TIN_NHAN qua gọi lại
BoDieuPhoiVan --> VanDau
BoDieuPhoiVan --> BoGiaiQuyetDem
BoGiaiQuyetDem --> HanhDongDem
BoGiaiQuyetDem --> KetQuaDem
BoDieuPhoiVan --> BoKiemTraThangThua
class BoChiaVai {
  - nguonNgauNhien : NguonNgauNhien
  + taoVai(loai) : VaiTro
  + sinhDanhSachVai(cauHinh) : List<VaiTro>
  + xaoTron(danhSach) : List
  + chiaVai(van, cauHinh) : Map<String, LoaiVai>
}
note right of BoChiaVai
  Factory: bảng LoaiVai → lớp cụ thể.
  Fisher–Yates qua cổng NguonNgauNhien.
end note
BoDieuPhoiVan --> BoChiaVai
class BoHenGio {
  - dongHo : DongHo
  + datHen(ma, thoiHanMs, khiHetGio) : long
  + huy(ma) : void
  + layHetHanLuc(ma) : long
}
note right of BoHenGio : Tác nhân AC04 — chỉ lớp này đặt hạn
class CongLuaChon {
  + cho(nguoiChoiId, thoiHanMs, kiemTra) : Promise<T | null>
  + ghiNhan(nguoiChoiId, luaChon) : void
  + huy(nguoiChoiId) : void
}
note right of CongLuaChon
  Cái nào đến trước: lệnh người chơi (socket hoặc
  người chơi ảo, cùng một cửa) hoặc hết giờ → null (BR12).
end note
CongLuaChon --> BoHenGio
BoDieuPhoiVan --> CongLuaChon
BoDieuPhoiVan --> BoHenGio
BoChiaVai ..> VaiTro : <<create>>
BoChiaVai ..> CauHinhVai
@enduml
