# Giá trị mặc định chạy được ngay cho môi trường phát triển. KHÔNG dùng cho máy chủ thật.
POSTGRES_USER=moonvillage
POSTGRES_PASSWORD=moonvillage
POSTGRES_DB=moonvillage
POSTGRES_PORT=5433

# Máy chủ ứng dụng
PORT=3000
DATABASE_URL=postgresql://moonvillage:moonvillage@localhost:5433/moonvillage

# Chỉ bật ở môi trường phát triển — ROADMAP 4.5
CHO_PHEP_NGUOI_CHOI_AO=true

# Bản Docker (npm run docker:up) — mở ứng dụng ở http://localhost:APP_PORT
APP_PORT=8080
# Khóa ký phiên đăng nhập. Giá trị này chỉ để chạy thử trên máy — máy chủ thật phải đổi.
JWT_SECRET=chi-dung-khi-chay-thu-tren-may-doi-o-may-chu-that
